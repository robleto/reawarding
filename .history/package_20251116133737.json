{
  "name": "reawarding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "backfill:imdb": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node scripts/backfill-imdb-ids.ts",
    "backfill:tmdb": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node scripts/backfill-tmdb-ids.ts",
    "func:deploy:backfill-ids": "supabase functions deploy backfill-external-ids",
    "func:invoke:backfill-ids": "bash -lc 'set -a; source .env >/dev/null 2>&1 || true; curl -sS -X POST \"$NEXT_PUBLIC_SUPABASE_URL/functions/v1/backfill-external-ids?mode=both&limit=300\" -H \"X-CRON-SECRET: $CRON_SECRET\"'",
    "ingest:fresh": "bash -lc 'set -a; source .env >/dev/null 2>&1 || true; curl -sS -X POST \"$NEXT_PUBLIC_SUPABASE_URL/functions/v1/tmdb-fresh-movies\" -H \"X-CRON-SECRET: $CRON_SECRET\" -H \"Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY\"'",
    "clean": "rm -rf .next .turbo && echo '✅ Cleared Next.js and Turbopack caches'",
    "rebuild": "npm run clean && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@tailwindcss/typography": "^0.5.16",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^0.517.0",
    "next": "15.3.3",
    "next-themes": "^0.4.6",
    "pip": "^0.0.1",
    "puppeteer": "^22.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-window": "^2.2.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "19.1.8",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3"
  }
}
